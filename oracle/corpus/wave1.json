    {"name": "escape-tab", "pattern": "\\t", "subject": "a\tb", "expect": {"match": [1, 2]}},
    {"name": "escape-hex-two-digits", "pattern": "\\x41", "subject": "xA", "expect": {"match": [1, 2]}},
    {"name": "escape-hex-one-digit", "pattern": "\\x4", "subject_hex": "0004", "expect": {"match": [1, 2]}},
