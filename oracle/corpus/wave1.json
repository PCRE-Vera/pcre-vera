    {"name": "dot-excludes-nel-in-any-mode", "pattern_hex": "612e63", "subject_hex": "618563", "newline": "ANY", "expect": "nomatch"},

    {"name": "class-range", "pattern": "[a-c]+", "subject": "xabcdy", "expect": {"match": [1, 4]}},
