    {"name": "quantifier-brace-is-literal-when-not-a-quantifier", "pattern": "a{", "subject": "a{", "expect": {"match": [0, 2]}},
    {"name": "quantifier-brace-with-spaces", "pattern": "a{ 2 }", "subject": "aa", "expect": {"match": [0, 2]}},
    {"name": "quantifier-ungreedy-option", "pattern": "a+", "subject": "aaa", "options": ["UNGREEDY"], "expect": {"match": [0, 1]}},
