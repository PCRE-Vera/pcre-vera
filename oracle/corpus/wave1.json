    {"name": "escape-punctuation-is-itself", "pattern": "\\.", "subject": "a.b", "expect": {"match": [1, 2]}},
    {"name": "escape-underscore-is-itself", "pattern": "\\_", "subject": "_", "expect": {"match": [0, 1]}},

