    {"name": "anchor-caret", "pattern": "^abc", "subject": "xabc", "expect": "nomatch"},
    {"name": "anchor-caret-at-start", "pattern": "^abc", "subject": "abcx", "expect": {"match": [0, 3]}},
    {"name": "anchor-caret-multiline", "pattern": "^b", "subject": "a\nb", "options": ["MULTILINE"], "expect": {"match": [2, 3]}},
    {"name": "anchor-caret-multiline-not-at-end", "pattern": "^", "subject": "a\n", "options": ["MULTILINE"], "expect": {"match": [0, 0]}, "note": "multiline ^ does not match at the very end of the subject"},
