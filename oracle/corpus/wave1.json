    {"name": "class-negated-matches-newline", "pattern": "[^a]", "subject": "a\n", "expect": {"match": [1, 2]}},
    {"name": "class-posix-alpha", "pattern": "[[:alpha:]]+", "subject": "12ab34", "expect": {"match": [2, 4]}},
    {"name": "class-posix-negated", "pattern": "[[:^digit:]]", "subject": "1a", "expect": {"match": [1, 2]}},
    {"name": "class-posix-xdigit", "pattern": "[[:xdigit:]]+", "subject": "zzAF9zz", "expect": {"match": [2, 5]}},
    {"name": "class-posix-punct", "pattern": "[[:punct:]]", "subject": "a;b", "expect": {"match": [1, 2]}},
    {"name": "class-caret-is-literal-when-not-first", "pattern": "[a^]", "subject": "^", "expect": {"match": [0, 1]}},
    {"name": "class-hyphen-at-end-is-literal", "pattern": "[a-]", "subject": "-", "expect": {"match": [0, 1]}},
    {"name": "class-hyphen-at-start-is-literal", "pattern": "[-a]", "subject": "-", "expect": {"match": [0, 1]}},
    {"name": "class-bracket-first-is-literal", "pattern": "[]a]", "subject": "]", "expect": {"match": [0, 1]}},
    {"name": "class-negated-bracket-first-is-literal", "pattern": "[^]a]", "subject": "b", "expect": {"match": [0, 1]}},
    {"name": "class-bracket-range", "pattern": "[]-a]", "subject": "^", "expect": {"match": [0, 1]}},
    {"name": "class-escape-inside", "pattern": "[\\d_]+", "subject": "a1_2b", "expect": {"match": [1, 4]}},
    {"name": "class-backspace-escape", "pattern": "[\\b]", "subject_hex": "6108", "expect": {"match": [1, 2]}, "note": "\\b is a backspace inside a class and a word boundary outside one"},
    {"name": "class-quoted-run", "pattern": "[\\Qa-c\\E]", "subject": "-", "expect": {"match": [0, 1]}},
    {"name": "class-quoted-run-excludes-range", "pattern": "[\\Qa-c\\E]", "subject": "b", "expect": "nomatch"},
    {"name": "class-hex-range", "pattern": "[\\x41-\\x43]", "subject": "B", "expect": {"match": [0, 1]}},
    {"name": "class-negated-set-escape", "pattern": "[\\D]", "subject": "1a", "expect": {"match": [1, 2]}},

    {"name": "escape-digit", "pattern": "\\d+", "subject": "ab123cd", "expect": {"match": [2, 5]}},
    {"name": "escape-word", "pattern": "\\w+", "subject": " a_1  ", "expect": {"match": [1, 4]}},
    {"name": "escape-space", "pattern": "\\s+", "subject": "a \t b", "expect": {"match": [1, 4]}},
