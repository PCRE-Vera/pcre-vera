{
  "schema": 1,
  "note": "The wave 1 differential corpus: every case is inside the subset DESIGN.md section 2.1 claims for wave 1, so both pcre2 and our own engine are expected to give exactly these answers.",
  "cases": [
    {"name": "literal-found", "pattern": "abc", "subject": "xxabcxx", "expect": {"match": [2, 5]}},
    {"name": "literal-absent", "pattern": "abc", "subject": "abd", "expect": "nomatch"},
    {"name": "literal-empty-pattern", "pattern": "", "subject": "abc", "expect": {"match": [0, 0]}},
    {"name": "literal-empty-subject", "pattern": "a", "subject": "", "expect": "nomatch"},
    {"name": "literal-nul-byte", "pattern_hex": "6100620063", "subject_hex": "78610062006300", "expect": {"match": [1, 6]}, "note": "a NUL is an ordinary byte in a pattern and in a subject"},
    {"name": "literal-high-byte", "pattern_hex": "ff", "subject_hex": "61ff62", "expect": {"match": [1, 2]}},
    {"name": "literal-leftmost-wins", "pattern": "a", "subject": "bab", "expect": {"match": [1, 2]}},

    {"name": "dot-skips-newline", "pattern": "a.c", "subject": "a\nc", "expect": "nomatch"},
    {"name": "dot-dotall", "pattern": "a.c", "subject": "a\nc", "options": ["DOTALL"], "expect": {"match": [0, 3]}},
    {"name": "dot-matches-high-byte", "pattern": "a.c", "subject_hex": "61ff63", "expect": {"match": [0, 3]}},
    {"name": "dot-excludes-cr-in-cr-mode", "pattern": "a.c", "subject": "a\rc", "newline": "CR", "expect": "nomatch"},
