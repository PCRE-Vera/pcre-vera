{
  "schema": 1,
  "note": [
    "The hand-written starting corpus for differential testing. A case says what",
    "PCRE is supposed to do; the runner asks the pinned build whether it agrees.",
    "Expectations were written from what the constructs mean, then checked, so a",
    "disagreement is either a mistake of ours or a change in pcre2. Compile error",
    "offsets are the one exception: where pcre2 points inside the pattern is a",
    "library convention, so those numbers were read off the pinned build, which",
    "is exactly what our engine has to reproduce.",
    "Patterns and subjects are Latin-1 text, or hex where that reads better."
  ],
  "cases": [
    {"name": "literal-found", "pattern": "abc", "subject": "xxabcxx", "expect": {"match": [2, 5]}},
    {"name": "literal-absent", "pattern": "abc", "subject": "abd", "expect": "nomatch"},
    {"name": "literal-empty-pattern", "pattern": "", "subject": "abc", "expect": {"match": [0, 0]}},
    {"name": "literal-nul-byte", "pattern_hex": "610062", "subject_hex": "78610062", "expect": {"match": [1, 4]},
     "note": "a NUL is an ordinary byte, in the pattern as well as the subject"},
    {"name": "literal-high-byte", "pattern_hex": "ff", "subject_hex": "00ff00", "expect": {"match": [1, 2]}},

    {"name": "dot-skips-newline", "pattern": "a.c", "subject": "a\nc", "expect": "nomatch"},
    {"name": "dot-dotall", "pattern": "a.c", "options": ["DOTALL"], "subject": "a\nc", "expect": {"match": [0, 3]}},
    {"name": "dot-matches-high-byte", "pattern": "a.c", "subject_hex": "61ff63", "expect": {"match": [0, 3]}},
    {"name": "dot-excludes-cr-in-cr-mode", "pattern": "a.c", "newline": "CR", "subject": "a\rc", "expect": "nomatch"},
    {"name": "dot-matches-cr-in-lf-mode", "pattern": "a.c", "newline": "LF", "subject": "a\rc", "expect": {"match": [0, 3]}},

    {"name": "class-range", "pattern": "[a-c]+", "subject": "xabcdy", "expect": {"match": [1, 4]}},
    {"name": "class-negated", "pattern": "[^a-c]", "subject": "abcd", "expect": {"match": [3, 4]}},
    {"name": "class-posix-alpha", "pattern": "[[:alpha:]]+", "subject": "12ab34", "expect": {"match": [2, 4]}},
    {"name": "class-posix-negated", "pattern": "[[:^digit:]]", "subject": "1a", "expect": {"match": [1, 2]}},
    {"name": "class-caret-is-literal-when-not-first", "pattern": "[a^]", "subject": "^", "expect": {"match": [0, 1]}},
    {"name": "class-hyphen-at-end-is-literal", "pattern": "[a-]", "subject": "-", "expect": {"match": [0, 1]}},
    {"name": "escape-digit", "pattern": "\\d+", "subject": "ab123cd", "expect": {"match": [2, 5]}},
    {"name": "escape-word", "pattern": "\\w+", "subject": " a_1 ", "expect": {"match": [1, 4]}},
    {"name": "escape-space", "pattern": "\\s+", "subject": "a \t b", "expect": {"match": [1, 4]}},
    {"name": "escape-horizontal-space", "pattern": "\\h", "subject": "a\tb", "expect": {"match": [1, 2]}},
    {"name": "escape-vertical-space", "pattern": "\\v", "subject": "a\nb", "expect": {"match": [1, 2]}},
    {"name": "escape-not-digit", "pattern": "\\D", "subject": "12a", "expect": {"match": [2, 3]}},

    {"name": "bsr-crlf-is-one-newline", "pattern": "\\R", "subject": "a\r\nb", "expect": {"match": [1, 3]}},
    {"name": "bsr-unicode-matches-vertical-tab", "pattern": "\\R", "bsr": "UNICODE", "subject_hex": "610b62", "expect": {"match": [1, 2]}},
    {"name": "bsr-anycrlf-rejects-vertical-tab", "pattern": "\\R", "bsr": "ANYCRLF", "subject_hex": "610b62", "expect": "nomatch"},

    {"name": "anchor-caret", "pattern": "^abc", "subject": "xabc", "expect": "nomatch"},
    {"name": "anchor-caret-multiline", "pattern": "^b", "options": ["MULTILINE"], "subject": "a\nb", "expect": {"match": [2, 3]}},
    {"name": "anchor-dollar-before-final-newline", "pattern": "c$", "subject": "abc\n", "expect": {"match": [2, 3]}},
    {"name": "anchor-dollar-endonly", "pattern": "c$", "options": ["DOLLAR_ENDONLY"], "subject": "abc\n", "expect": "nomatch"},
    {"name": "anchor-subject-start", "pattern": "\\Aa", "subject": "ba", "expect": "nomatch"},
    {"name": "anchor-absolute-end", "pattern": "c\\z", "subject": "abc\n", "expect": "nomatch"},
    {"name": "anchor-end-allowing-newline", "pattern": "c\\Z", "subject": "abc\n", "expect": {"match": [2, 3]}},
    {"name": "word-boundary", "pattern": "\\bcat\\b", "subject": "a cat.", "expect": {"match": [2, 5]}},
    {"name": "word-boundary-at-subject-start", "pattern": "\\ba", "subject": "a", "expect": {"match": [0, 1]}},
    {"name": "word-boundary-negated", "pattern": "\\Bat", "subject": "cat", "expect": {"match": [1, 3]}},
    {"name": "notbol", "pattern": "^a", "match_options": ["NOTBOL"], "subject": "abc", "expect": "nomatch"},
    {"name": "noteol", "pattern": "c$", "match_options": ["NOTEOL"], "subject": "abc", "expect": "nomatch"},

    {"name": "alternation-first-branch-wins", "pattern": "a|ab", "subject": "ab", "expect": {"match": [0, 1]},
     "note": "ordered alternation: the shorter branch wins because it comes first"},
    {"name": "alternation-second-branch", "pattern": "x|ab", "subject": "ab", "expect": {"match": [0, 2]}},
    {"name": "alternation-empty-branch", "pattern": "a|", "subject": "b", "expect": {"match": [0, 0]}},

    {"name": "quantifier-greedy-star", "pattern": "a*", "subject": "aaa", "expect": {"match": [0, 3]}},
    {"name": "quantifier-star-matches-empty", "pattern": "a*", "subject": "bbb", "expect": {"match": [0, 0]}},
    {"name": "quantifier-lazy-star", "pattern": "a*?", "subject": "aaa", "expect": {"match": [0, 0]}},
    {"name": "quantifier-lazy-plus", "pattern": "a+?", "subject": "aaa", "expect": {"match": [0, 1]}},
    {"name": "quantifier-greedy-question", "pattern": "ab?", "subject": "ab", "expect": {"match": [0, 2]}},
    {"name": "quantifier-lazy-question", "pattern": "ab??", "subject": "ab", "expect": {"match": [0, 1]}},
    {"name": "quantifier-counted-exact", "pattern": "a{3}", "subject": "aaaa", "expect": {"match": [0, 3]}},
    {"name": "quantifier-counted-range", "pattern": "a{2,3}", "subject": "aaaa", "expect": {"match": [0, 3]}},
    {"name": "quantifier-counted-open", "pattern": "a{2,}", "subject": "aaaa", "expect": {"match": [0, 4]}},
    {"name": "quantifier-counted-lazy", "pattern": "a{2,3}?", "subject": "aaaa", "expect": {"match": [0, 2]}},
    {"name": "quantifier-ungreedy-option", "pattern": "a+", "options": ["UNGREEDY"], "subject": "aaa", "expect": {"match": [0, 1]}},
    {"name": "quantifier-backtracks", "pattern": "a+b", "subject": "aaab", "expect": {"match": [0, 4]}},
    {"name": "quantifier-over-group", "pattern": "(?:ab)+", "subject": "ababx", "expect": {"match": [0, 4]}},

    {"name": "capture-two-groups", "pattern": "(a)(b)", "subject": "ab", "expect": {"match": [0, 2, 0, 1, 1, 2]}},
    {"name": "capture-unset-group-is-minus-one", "pattern": "(a)|(b)", "subject": "b", "expect": {"match": [0, 1, -1, -1, 0, 1]}},
    {"name": "capture-non-capturing-group", "pattern": "(?:a)(b)", "subject": "ab", "expect": {"match": [0, 2, 1, 2]}},
    {"name": "capture-nested", "pattern": "((a)b)", "subject": "ab", "expect": {"match": [0, 2, 0, 2, 0, 1]}},
    {"name": "capture-repeated-keeps-last", "pattern": "(a|b)+", "subject": "ab", "expect": {"match": [0, 2, 1, 2]}},
    {"name": "capture-named", "pattern": "(?<x>a)(?<y>b)", "subject": "ab", "expect": {"match": [0, 2, 0, 1, 1, 2]}},
    {"name": "capture-no-auto-capture", "pattern": "(a)(b)", "options": ["NO_AUTO_CAPTURE"], "subject": "ab", "expect": {"match": [0, 2]}},

    {"name": "compile-group-count", "pattern": "(a)(?:b)(c)", "expect": {"compiled": {"captures": 2}}},
    {"name": "compile-group-names", "pattern": "(?<year>\\d{4})-(?<month>\\d{2})", "expect": {"compiled": {"captures": 2, "names": {"year": 1, "month": 2}}}},
    {"name": "compile-name-and-number-mixed", "pattern": "(a)(?<tail>b)", "expect": {"compiled": {"captures": 2, "names": {"tail": 2}}}},

    {"name": "option-caseless", "pattern": "abc", "options": ["CASELESS"], "subject": "AbC", "expect": {"match": [0, 3]}},
    {"name": "option-inline-caseless", "pattern": "(?i)abc", "subject": "ABC", "expect": {"match": [0, 3]}},
    {"name": "option-inline-caseless-scoped", "pattern": "(?i:ab)c", "subject": "ABc", "expect": {"match": [0, 3]}},
    {"name": "option-inline-caseless-scope-ends", "pattern": "(?i:ab)c", "subject": "ABC", "expect": "nomatch"},
    {"name": "option-extended", "pattern": "a # comment\nb", "options": ["EXTENDED"], "subject": "ab", "expect": {"match": [0, 2]}},
    {"name": "quote-escape", "pattern": "\\Qa.c\\E", "subject": "a.c", "expect": {"match": [0, 3]}},
    {"name": "quote-escape-is-literal", "pattern": "\\Qa.c\\E", "subject": "abc", "expect": "nomatch"},
    {"name": "comment-group", "pattern": "a(?#ignored)b", "subject": "ab", "expect": {"match": [0, 2]}},

    {"name": "tables-caseless-does-not-fold-high-bytes", "pattern_hex": "e9", "options": ["CASELESS"], "subject_hex": "c9", "expect": "nomatch",
     "note": "the default C locale tables fold ASCII only, so latin-1 e-acute is not c-acute"},
    {"name": "tables-word-class-excludes-high-bytes", "pattern": "\\w", "subject_hex": "e9", "expect": "nomatch"},

    {"name": "start-offset", "pattern": "a", "subject": "aaa", "start": 1, "expect": {"match": [1, 2]}},
    {"name": "start-offset-at-end", "pattern": "a*", "subject": "aaa", "start": 3, "expect": {"match": [3, 3]}},
    {"name": "start-offset-past-end", "pattern": "a", "subject": "abc", "start": 4, "expect": {"merror": -33},
     "note": "PCRE2_ERROR_BADOFFSET; our engine answers BadInput for the same input"},
    {"name": "start-offset-does-not-hide-earlier-bytes", "pattern": "(?<=a)b", "subject": "ab", "start": 1, "expect": {"match": [1, 2]},
     "note": "a lookbehind still reads before the start offset, which is why bounds take the whole subject length"},

    {"name": "match-option-notempty", "pattern": "a*", "match_options": ["NOTEMPTY"], "subject": "bbb", "expect": "nomatch"},
    {"name": "match-option-notempty-atstart", "pattern": "a*", "match_options": ["NOTEMPTY_ATSTART"], "subject": "ba", "expect": {"match": [1, 2]}},
    {"name": "match-option-anchored", "pattern": "b", "match_options": ["ANCHORED"], "subject": "ab", "expect": "nomatch"},
    {"name": "option-endanchored", "pattern": "a", "options": ["ENDANCHORED"], "subject": "ab", "expect": "nomatch"},
    {"name": "notempty-atstart-anchored-refuses-an-empty-match", "pattern": "a*", "match_options": ["NOTEMPTY_ATSTART", "ANCHORED"], "subject": "ba", "expect": "nomatch",
     "note": "one attempt with the option pair the find-all retry step uses, not the iterator itself, which does not exist until the backends do"},

    {"name": "newline-crlf-dollar", "pattern": "b$", "options": ["MULTILINE"], "newline": "CRLF", "subject": "b\r\nc", "expect": {"match": [0, 1]}},
    {"name": "newline-lf-dollar-ignores-cr", "pattern": "b$", "options": ["MULTILINE"], "newline": "LF", "subject": "b\rc", "expect": "nomatch"},

    {"name": "backref-numeric", "pattern": "(a+)\\1", "subject": "aaaa", "expect": {"match": [0, 4, 0, 2]}},
    {"name": "backref-named", "pattern": "(?<x>ab)\\k<x>", "subject": "abab", "expect": {"match": [0, 4, 0, 2]}},
    {"name": "lookahead-positive", "pattern": "a(?=b)", "subject": "ab", "expect": {"match": [0, 1]}},
    {"name": "lookahead-negative", "pattern": "a(?!b)", "subject": "ab ac", "expect": {"match": [3, 4]}},
    {"name": "lookbehind-positive", "pattern": "(?<=a)b", "subject": "ab", "expect": {"match": [1, 2]}},
    {"name": "lookbehind-negative", "pattern": "(?<!a)b", "subject": "cb", "expect": {"match": [1, 2]}},
    {"name": "atomic-group", "pattern": "(?>a+)b", "subject": "aab", "expect": {"match": [0, 3]}},
    {"name": "atomic-group-gives-nothing-back", "pattern": "(?>a+)a", "subject": "aaa", "expect": "nomatch"},
    {"name": "possessive-quantifier", "pattern": "a++b", "subject": "aab", "expect": {"match": [0, 3]}},
    {"name": "possessive-quantifier-gives-nothing-back", "pattern": "a++a", "subject": "aaa", "expect": "nomatch"},
    {"name": "keep-out", "pattern": "a\\Kb", "subject": "ab", "expect": {"match": [1, 2]}},

    {"name": "varlookbehind-at-the-build-limit", "pattern": "(?<=a{1,255})b", "expect": {"compiled": {"captures": 0}},
     "note": "pins --with-max-varlookbehind=255, which pcre2_config cannot report; only behavior can"},
    {"name": "varlookbehind-over-the-build-limit", "pattern": "(?<=a{1,256})b", "expect": {"cerror": {"code": 200, "offset": 0}}},

    {"name": "utf-property-uppercase", "pattern": "\\p{Lu}", "options": ["UTF"], "subject_hex": "61c389", "expect": {"match": [1, 3]},
     "note": "U+00C9 encoded as two bytes; offsets stay byte offsets"},
    {"name": "utf-rejects-invalid-subject", "pattern": "a", "options": ["UTF"], "subject_hex": "ff", "expect": {"merror": -23}},

    {"name": "cerror-missing-closing-paren", "pattern": "(a", "expect": {"cerror": {"code": 114, "offset": 2}}},
    {"name": "cerror-unmatched-closing-paren", "pattern": "a)", "expect": {"cerror": {"code": 122, "offset": 2}}},
    {"name": "cerror-nothing-to-repeat", "pattern": "+a", "expect": {"cerror": {"code": 109, "offset": 1}}},
    {"name": "cerror-missing-closing-bracket", "pattern": "[a", "expect": {"cerror": {"code": 106, "offset": 2}}},
    {"name": "cerror-class-range-out-of-order", "pattern": "[z-a]", "expect": {"cerror": {"code": 108, "offset": 4}}},
    {"name": "cerror-quantifier-numbers-out-of-order", "pattern": "a{3,2}", "expect": {"cerror": {"code": 104, "offset": 5}}},
    {"name": "cerror-backslash-at-end", "pattern": "\\", "expect": {"cerror": {"code": 101, "offset": 1}}},
    {"name": "cerror-backref-to-nothing", "pattern": "\\1", "expect": {"cerror": {"code": 115, "offset": 2}}},
    {"name": "cerror-unknown-after-question", "pattern": "(?Z)", "expect": {"cerror": {"code": 111, "offset": 3}}}
  ]
}
